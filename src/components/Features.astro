---
const features = [
  {
    title: 'Без боли',
    text: 'Обезболивающий гель перед уколом и современная анестезия. Для тревожных - лечение во сне.',
    icon: '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/>',
  },
  {
    title: 'Честная смета',
    text: 'План лечения с ценами на бумаге. Итоговая сумма не вырастет в процессе.',
    icon: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  },
  {
    title: '3D-диагностика',
    text: 'Компьютерный томограф прямо в клинике: точный диагноз за 10 минут.',
    icon: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
  },
  {
    title: 'Рассрочка 0%',
    text: 'Лечение сейчас, оплата частями до 12 месяцев без первого взноса и переплат.',
    icon: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h3"/>',
  },
];
---

<section class="border-y border-line bg-surface">
  <ul class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    {features.map((f) => (
      <li>
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-mint text-primary">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
        </div>
        <h2 class="text-lg font-semibold">{f.title}</h2>
        <p class="mt-2 leading-relaxed text-muted">{f.text}</p>
      </li>
    ))}
  </ul>
</section>
