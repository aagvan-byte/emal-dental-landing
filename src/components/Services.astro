---
import { services } from '../data/site';
---

<section id="services" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Услуги и цены</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Указаны базовые цены. Точную стоимость врач назовёт после бесплатного осмотра и закрепит в смете.
      </p>
      <a
        href="#booking"
        class="mt-8 inline-block rounded-full bg-primary px-7 py-3.5 font-semibold text-white transition-colors hover:bg-primary-hover"
      >
        Получить план лечения
      </a>
    </div>

    <ul class="divide-y divide-line rounded-2xl border border-line bg-surface">
      {services.map((s) => (
        <li class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
          <div>
            <h3 class="font-semibold">{s.name}</h3>
            <p class="mt-0.5 text-sm text-muted">{s.note}</p>
          </div>
          <p class="shrink-0 text-right font-display font-bold whitespace-nowrap text-primary">{s.price}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
