---
import { Image } from 'astro:assets';
import { services } from '../data/site';
import smileImg from '../assets/smile.jpg';

// Демо-форма: заявка никуда не отправляется, показывается сообщение об успехе.
// Для реального клиента подключим отправку в Telegram или на почту.
const field =
  'mt-2 block w-full rounded-xl border border-line bg-surface px-4 py-3 text-base outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20';
---

<section id="booking" class="bg-primary text-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Запишитесь на бесплатную консультацию</h2>
      <p class="mt-4 text-lg leading-relaxed text-white">
        Оставьте телефон - администратор перезвонит за 10 минут и подберёт удобное время.
      </p>
      <Image
        src={smileImg}
        alt="Улыбающаяся девушка с ровными белыми зубами"
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="mt-8 hidden aspect-[3/2] w-full rounded-3xl object-cover md:block"
      />
    </div>

    <div>
      <form id="booking-form" class="rounded-2xl bg-surface p-6 text-ink shadow-2xl sm:p-8" novalidate>
        <div class="grid gap-5">
          <label>
            <span class="font-medium">Имя</span>
            <input name="name" type="text" required autocomplete="given-name" class={field} />
          </label>
          <label>
            <span class="font-medium">Телефон</span>
            <input name="phone" type="tel" required autocomplete="tel" placeholder="+7 (___) ___-__-__" pattern="[\d\s\(\)\+\-]{10,}" class={field} />
          </label>
          <label>
            <span class="font-medium">Что беспокоит</span>
            <select name="service" class={field}>
              <option value="">Нужна консультация</option>
              {services.slice(1).map((s) => <option>{s.name}</option>)}
            </select>
          </label>
          <!-- Ловушка для спам-ботов: человек это поле не видит, бот заполняет -->
          <label class="absolute -left-[9999px]" aria-hidden="true">
            Сайт
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <p id="form-error" class="mt-4 hidden text-sm font-medium text-red-700" role="alert">
          Пожалуйста, укажите имя и телефон.
        </p>

        <button
          type="submit"
          class="mt-6 w-full rounded-full bg-primary px-7 py-3.5 font-semibold text-white transition-colors hover:bg-primary-hover"
        >
          Записаться
        </button>
        <p class="mt-3 text-center text-xs text-muted">Нажимая кнопку, вы соглашаетесь на обработку персональных данных.</p>
      </form>

      <div id="form-success" class="hidden rounded-2xl bg-surface p-8 text-center text-ink shadow-2xl" role="status">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-mint text-primary">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
        </div>
        <h3 class="mt-4 text-xl font-semibold">Заявка отправлена!</h3>
        <p class="mt-2 text-muted">Перезвоним в течение 10 минут.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const error = document.getElementById('form-error')!;
  const success = document.getElementById('form-success')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // Бот заполнил скрытое поле - молча ничего не делаем
    if ((form.elements.namedItem('website') as HTMLInputElement).value) return;
    if (!form.checkValidity()) {
      error.classList.remove('hidden');
      (form.querySelector(':invalid') as HTMLElement | null)?.focus();
      return;
    }
    error.classList.add('hidden');
    form.classList.add('hidden');
    success.classList.remove('hidden');
  });
</script>
