---
import { Image } from 'astro:assets';
import { stats } from '../data/site';
import heroImg from '../assets/hero.jpg';

const perks = ['Бесплатная консультация', 'Рассрочка 0%', 'Смета не меняется'];
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 md:grid-cols-2 md:py-20">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-mint px-4 py-1.5 text-sm font-semibold text-primary">
        Стоматология рядом с метро · без выходных
      </p>
      <h1 class="font-display text-4xl leading-tight font-bold text-balance sm:text-5xl lg:text-[3.5rem]">
        Лечим зубы без боли и без сюрпризов в чеке
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
        Покажем на 3D-снимке, что происходит с зубами, и дадим письменную смету. Цена не изменится до конца лечения.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {perks.map((p) => (
          <li class="flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 text-sm font-medium">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-accent" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
            {p}
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#booking"
          class="rounded-full bg-primary px-7 py-3.5 text-center font-semibold text-white shadow-lg shadow-primary/20 transition-colors hover:bg-primary-hover"
        >
          Записаться на консультацию
        </a>
        <a
          href="#services"
          class="rounded-full border border-primary/30 px-7 py-3.5 text-center font-semibold text-primary transition-colors hover:bg-mint"
        >
          Цены на услуги
        </a>
      </div>

      <dl class="mt-10 grid max-w-md grid-cols-3 gap-4">
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-display text-2xl font-bold text-primary sm:text-3xl">{s.value}</dd>
            <dd class="mt-1 text-sm leading-snug text-muted" aria-hidden="true">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-md md:max-w-none">
      <div class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-mint blur-2xl"></div>
      <Image
        src={heroImg}
        alt="Стоматолог беседует с улыбающейся пациенткой в кресле"
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full rounded-3xl object-cover object-[35%_center] shadow-2xl shadow-primary/20 md:aspect-[4/5]"
      />
      <div class="absolute -bottom-5 left-4 flex items-center gap-3 rounded-2xl bg-surface px-4 py-3 shadow-xl shadow-primary/10 sm:left-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-mint text-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
        </div>
        <p class="text-sm leading-tight"><span class="font-semibold">Гарантия до 5 лет</span><br /><span class="text-muted">на пломбы и коронки</span></p>
      </div>
    </div>
  </div>
</section>
