---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Services from '../components/Services.astro';
import Technology from '../components/Technology.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Booking from '../components/Booking.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Эмаль - стоматология в Москве: лечение без боли"
  description="Лечение, имплантация, отбеливание и элайнеры. Бесплатная консультация с 3D-снимком, рассрочка 0%, фиксированная смета."
>
  <Header />
  <main id="main">
    <Hero />
    <Features />
    <Services />
    <Technology />
    <Steps />
    <Reviews />
    <Faq />
    <Booking />
    <Contacts />
  </main>
  <Footer />
</Layout>
